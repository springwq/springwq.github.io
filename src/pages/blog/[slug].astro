---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, postPath, postTerms, seriesNeighbors } from '../../lib/posts';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const posts = await getPosts();
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const { prev, next } = seriesNeighbors(post, posts);
const canonicalPath = postPath(post.id);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: 'Steven Wu', url: SITE.url },
  mainEntityOfPage: new URL(canonicalPath, SITE.url).href,
  license: 'https://creativecommons.org/licenses/by-nc-sa/4.0/',
  keywords: post.data.tags.join(', '),
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  published={post.data.pubDate}
  jsonLd={jsonLd}
>
  <article class="column">
    <header>
      <p class="kicker">文章</p>
      <h1>{post.data.title}</h1>
      <p class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {
          post.data.series && (
            <>
              <span aria-hidden="true">·</span>
              <span>系列 · {post.data.series}</span>
            </>
          )
        }
        {
          postTerms(post).map((term) => (
            <>
              <span aria-hidden="true">·</span>
              {term.href ? <a href={term.href}>{term.label}</a> : <span>{term.label}</span>}
            </>
          ))
        }
      </p>
    </header>
    {
      toc.length >= 3 && (
        <nav class="toc" aria-label="目录">
          <p class="kicker">目录</p>
          <ol>
            {toc.map((heading) => (
              <li class={heading.depth === 3 ? 'depth-3' : undefined}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="prose">
      <Content />
    </div>
    {
      (prev || next) && (
        <nav class="series" aria-label={post.data.series ?? '系列'}>
          {prev && (
            <a href={postPath(prev.id)}>前一篇 · {prev.data.title}</a>
          )}
          {next && (
            <a href={postPath(next.id)}>后一篇 · {next.data.title}</a>
          )}
        </nav>
      )
    }
    <p class="back"><a href="/blog/">返回文章</a></p>
  </article>
</Base>
