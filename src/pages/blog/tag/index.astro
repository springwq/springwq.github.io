---
import Base from '../../../layouts/Base.astro';
import { getPosts, tagPath, tagSlug } from '../../../lib/posts';

const posts = await getPosts();
const counts = new Map<string, { label: string; count: number }>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const slug = tagSlug(tag);
    const current = counts.get(slug);
    if (current) current.count += 1;
    else counts.set(slug, { label: tag, count: 1 });
  }
}
const tags = [...counts.entries()].sort((a, b) => a[1].label.localeCompare(b[1].label, 'zh'));
---

<Base title="标签" description="文章标签。">
  <p class="kicker">Tags</p>
  <h1>标签</h1>
  <ul class="tag-list">
    {
      tags.map(([, tag]) => (
        <li>
          <a href={tagPath(tag.label)}>
            {tag.label} <span class="tag-count">{tag.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="back"><a href="/blog/">返回文章</a></p>
</Base>
