---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const description = 'Steven Wu 写过的文章，包括 Ruby 元编程笔记，以及群晖 NAS 与 Docker。';
---

<Base title="文章" description={description}>
  <p class="kicker">Blog</p>
  <div class="section-head">
    <h1>文章</h1>
    <a class="more" href="/rss.xml">RSS</a>
  </div>
  <p class="page-intro">以前写的笔记都留在这里，按时间倒序。新的文章也会放在这个目录。</p>
  <PostList posts={posts} showTags />
  <p class="back"><a href="/blog/tag/">按标签看</a></p>
</Base>
