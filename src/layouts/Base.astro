---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  published?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, ogType = 'website', published, jsonLd, noindex = false } = Astro.props;
const documentTitle = title === SITE.title ? SITE.title : `${title} — ${SITE.title}`;
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site ?? SITE.url);
const image = new URL('/og.png', Astro.site ?? SITE.url);
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="author" content="Steven Wu" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Steven Wu" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    <link rel="alternate" type="application/rss+xml" title="Steven Wu" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121311" media="(prefers-color-scheme: dark)" />
    {json && <script type="application/ld+json" set:html={json} />}
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <Header />
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
